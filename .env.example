# ClickHouse connection
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# LLM (optional — used for context-exfil classifier + NL query box)
# Any provider supported by litellm: openai/gpt-4o-mini, anthropic/claude-haiku, etc.
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# Synthetic workload generator
EVENT_RATE_PER_SEC=200
ATTACK_INTERVAL_SEC=90

# Dashboard
DASHBOARD_PORT=8000

# Eval runner
EVAL_SCENARIOS_DIR=evals/scenarios
EVAL_RESULTS_DIR=evals/results

# NEW (v0.3.0): Slack webhook for critical/high alerts
# Create one at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
SLACK_NOTIFY_SEVERITIES=critical,high

# NEW (v0.3.0): PostgreSQL connection (for ClickHouse-vs-Postgres benchmark only)
# If unset, the benchmark runs ClickHouse-only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# NEW (v0.3.0): SDK config (used by src/sentinel_sdk)
SENTINEL_API_URL=http://localhost:8000
SENTINEL_APP_ID=default
SENTINEL_ENABLED=1
SENTINEL_BATCH_SIZE=100
SENTINEL_FLUSH_INTERVAL_SEC=1.0

# NEW (v0.2.0): hacker-bob integration
HACKER_BOB_ROOT=
BOB_SESSION_ROOT=

# NEW (v0.4.0): Enterprise — SOAR
SOAR_PLAYBOOKS_DIR=playbooks
PAGERDUTY_INTEGRATION_KEY=
JIRA_WEBHOOK_URL=

# NEW (v0.4.0): Enterprise — RBAC
SENTINEL_RBAC_USERS_FILE=
SENTINEL_API_KEY_PEPPER=
SENTINEL_AUDIT_LOG=audit.log.jsonl
